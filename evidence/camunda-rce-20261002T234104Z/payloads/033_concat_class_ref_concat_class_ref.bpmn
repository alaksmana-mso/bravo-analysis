<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="D_concat_class_ref" targetNamespace="x">
  <process id="concat_class_ref" isExecutable="true">
    <startEvent id="s"/>
    <serviceTask id="t" camunda:expression="${(''.getClass().forName('java'.concat('.lang.Ru').concat('ntime'))).getMethod('get'.concat('Runtime'))}" camunda:resultVariable="o"/>
    <endEvent id="e"/>
    <sequenceFlow id="f1" sourceRef="s" targetRef="t"/>
    <sequenceFlow id="f2" sourceRef="t" targetRef="e"/>
  </process>
</definitions>
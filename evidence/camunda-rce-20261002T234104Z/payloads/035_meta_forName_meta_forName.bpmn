<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="D_meta_forName" targetNamespace="x">
  <process id="meta_forName" isExecutable="true">
    <startEvent id="s"/>
    <serviceTask id="t" camunda:expression="${''.getClass().getClass().getMethod('forName', ''.getClass()).invoke(null, 'java.lang'.concat('.Run').concat('time'))}" camunda:resultVariable="o"/>
    <endEvent id="e"/>
    <sequenceFlow id="f1" sourceRef="s" targetRef="t"/>
    <sequenceFlow id="f2" sourceRef="t" targetRef="e"/>
  </process>
</definitions>
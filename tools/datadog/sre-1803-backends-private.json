                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  },
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "r",
                      "query": "sum:istio.mesh.request.count.total{reporter:destination AND destination_workload IN (prod-lora-cdc-bridges,prod-lora-diff-inspector) AND source_workload IN (nginx-ingress-protected-controller,prod-nginx-ingres-private-controller)} by {destination_workload, source_workload}.as_count()"
                    }
                  ],
                  "formulas": [

                    "line_type": "solid",
                    "line_width": "normal"
                  },
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "r",
                      "query": "sum:istio.mesh.request.count.total{reporter:destination AND destination_workload:prod-ms-bpm AND source_workload IN (nginx-ingress-protected-controller,prod-nginx-ingres-private-controller,prod-ms-krakend-gateway)} by {source_workload}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "r"
                    }

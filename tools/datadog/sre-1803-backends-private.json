          {
            "definition": {
              "type": "timeseries",
              "title": "Gateway logs: /bpm and /lora-task requests by response code (prod)",
              "title_align": "left",
              "title_size": "16",
              "show_legend": true,
              "legend_layout": "auto",
              "legend_columns": [
                "avg",
                "max",
